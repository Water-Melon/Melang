#!/bin/bash
#
# Copyright (C) Niklaus F.Schen.
#

os=`uname -s`
if ! case $os in MINGW*) false;; esac; then
    cc="gcc"
    mcc="gcc"
else
    cc="cc"
    mcc="cc"
fi
echo -e "#include <stdio.h>\nint main(void) {printf(\"1\");return 0;}" > .xcode.c
$mcc -o .xcode .xcode.c 2>/dev/null 1>&2
if [ $? -ne 0 ]; then
    mcc="$mcc -isysroot `xcrun --show-sdk-path`"
    cc="$cc -isysroot `xcrun --show-sdk-path`"
fi
rm -fr .xcode .xcode.c

#output installation path
echo -e "#include <stdio.h>\nint main(int argc, char *argv[]) {printf(\"%s\", argv[1]);return 0;}" > .path_generator.c
$cc -o path_generator .path_generator.c


wasm=0
debug=0
mysql=0
mysql_enable=0
mysql_header_path=`./path_generator /usr/include/mysql`
mysql_lib_path=`./path_generator /usr/lib64/mysql`
mysql_lib=""
dl=""
c99=""
libmelonPath=`./path_generator /usr/local/melon`
libPath=`./path_generator /usr/local/lib/melang_dynamic`
if ! case $os in MINGW*) false;; esac; then
    installPath=`./path_generator "$HOME/melang-0.6.0"`
    libmelonPath=`./path_generator "$HOME/libmelon"`
    libPath=`./path_generator $HOME/lib/melang_dynamic`
elif [ $os == 'Darwin' ]; then
    installPath=`./path_generator "/usr/local/bin/"`
else
    installPath=`./path_generator "/usr/bin/"`
fi

echo -e "Installation Path \t[$installPath]"

if [ $os = 'Linux' ]; then
    dl="-ldl"
fi

for param in $@
do
    if [ $param == "--help" ]; then
        echo -e "\nMelang installation help."
        echo "Copyright (C) Niklaus F.Schen."
        echo "Options:"
        echo -e "\t--prefix=INSTALL_PATH"
        echo -e "\t--melon-prefix=LIBMELON_INSTALL_PATH"
        echo -e "\t--lib-prefix=LIB_INSTALL_PATH"
        echo -e "\t--enable-mysql"
        echo -e "\t--mysql_header_path=MYSQL_CLIENT_HREADER_PATH"
        echo -e "\t--mysql_lib_path=MYSQL_CLIENT_LIB_PATH"
        echo -e "\t--enable-wasm"
        echo -e "\t--enable-tls\t\t(default: auto-detected from Melon)"
        echo -e "\t--disable-tls\t\t(skip tls.so even if Melon supports it)"
        echo -e "\t--openssl-include=OPENSSL_HEADERS_DIR"
        echo -e "\t--openssl-lib=OPENSSL_LIBRARY_DIR"
        echo -e "\t--debug"
        echo -e "\t--c99"
        exit 0
    fi
    param_prefix=`echo $param|cut -d '=' -f 1`
    param_suffix=`echo $param|cut -d '=' -f 2`
    if [ $param_prefix == "--prefix" ]; then
        installPath=`./path_generator $param_suffix`
    elif [ $param_prefix == "--melon-prefix" ]; then
        libmelonPath=`./path_generator $param_suffix`
    elif [ $param_prefix == "--lib-prefix" ]; then
        libPath=`./path_generator $param_suffix`
    elif [ $param_prefix == "--mysql_header_path" ]; then
        mysql_header_path=`./path_generator $param_suffix`
    elif [ $param_prefix == "--mysql_lib_path" ]; then
        mysql_lib_path=`./path_generator $param_suffix`
    elif [ $param_prefix == "--enable-mysql" ]; then
        mysql_enable=1
    elif [ $param_prefix == "--debug" ]; then
        debug=1
    elif [ $param_prefix == "--c99" ]; then
        c99="-std=c99 -DMLN_C99 -D_POSIX_C_SOURCE=200112L"
    elif [ $param_prefix == "--enable-wasm" ]; then
        wasm=1
        mcc="emcc"
    elif [ $param_prefix == "--enable-tls" ]; then
        # Compatibility no-op: TLS is auto-detected from Melon.  We
        # still accept the flag so existing build scripts don't break.
        tls_user_choice="enable"
    elif [ $param_prefix == "--disable-tls" ]; then
        # Opt-out: skip tls.so even when Melon supports TLS.  Useful
        # when the host has Melon-with-TLS but the user doesn't want
        # to ship a TLS-capable launcher.
        tls_user_choice="disable"
    elif [ $param_prefix == "--openssl-include" ]; then
        openssl_include=`./path_generator $param_suffix`
    elif [ $param_prefix == "--openssl-lib" ]; then
        openssl_lib=`./path_generator $param_suffix`
    fi
done

#
# TLS user choice -- decoupled from build_tls (which records what we
# actually decide to build).  Defaults to "auto": follow Melon.
#   auto    : build tls.so iff Melon supports TLS (the common case).
#   disable : never build tls.so.  http.so still builds but without
#             the https_request branch.
# --enable-tls is still accepted as a compatibility no-op; it does
# not force tls.so on when Melon was built without TLS.
#
: ${tls_user_choice:=auto}

rm -f path_generator .path_generator.c

#debug
if [ $debug -ne 0 ]; then
    if [ $wasm -eq 1 ]; then
        debug='-g -D__DEBUG__'
    else
        debug='-ggdb -D__DEBUG__'
    fi
else
    debug=''
fi

#wasm
if [ $wasm -eq 1 ]; then
    echo -e "Webassembly\t\t[enable]"

    #llvm
    llvm_flag=""
    cc --help|grep LLVM > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        llvm_flag="--llvm-lto 1"
    fi
fi

#test MySQL Asynchronous----------#
if [ $mysql_enable -eq 1 ]; then
    echo -e "#include <stdio.h>\n#include <mysql.h>" > mysql_test.c
    echo "int main(void){MYSQL *mysql_local = mysql_init(NULL);mysql_real_connect_nonblocking(mysql_local, NULL, NULL, NULL, NULL, 3306, NULL, 0);return 0;}" >> mysql_test.c
    cc -o mysql_test mysql_test.c -I/usr/include/mysql/ -L/usr/lib64/mysql/ -lmysqlclient 2>/dev/null
    if [ "$?" == "0" ]; then
        mysql=1
        mysql_lib="-I $mysql_header_path -L $mysql_lib_path -lmysqlclient"
        echo -e "MySQL Asynchronous\t[support]"
    else
        mysql=0
        echo -e "MySQL Asynchronous\t[not support]"
    fi
    rm -fr mysql_test mysql_test.c
fi
#test MySQL Asynchronous end------#

#---------------------------------------------------------------------#
# TLS detection                                                       #
#---------------------------------------------------------------------#
# The Melang TLS surface (tls.so + the http.https_request branch) is
# bound to the TLS support in Melon's libmelon_static.a.  Because
# Melang links the static archive into both melang itself and into
# every .so the launcher loads, the build needs to follow Melon's
# decision:
#
#   - If libmelon_static.a was built with --enable-tls, it carries
#     unresolved references to libssl / libcrypto.  Anything that
#     links the archive (melang, every .so) MUST then pass
#     -lssl -lcrypto, otherwise the link fails.  In that case we
#     also build tls.so (and turn on MLN_TLS for http.so's
#     https_request branch).
#
#   - If libmelon_static.a was built without --enable-tls, no TLS
#     code is present, no OpenSSL flags are needed, and tls.so is
#     skipped entirely.
#
# Detection inspects the static archive's symbol table directly
# (via `nm`, falling back to `ar t` listing).  This is preferable
# to a try-compile probe because it does NOT depend on the host
# having OpenSSL headers installed: a host that built Melon-with-
# TLS but later removed libssl-dev still has libmelon_static.a
# carrying TLS symbols, and the detection must succeed there so
# we can emit a clear "install OpenSSL headers" message instead
# of mis-detecting Melon as no-TLS and then dying at the final
# link step.
tls_flag=""
tls_inc=""
tls_lib=""
tls_ldflags=""
build_tls=0
melon_has_tls=0

# Discover OpenSSL.  Mirror Melon's autoprobe paths first, then let
# explicit overrides win (--openssl-include / --openssl-lib /
# OPENSSL_INCLUDE / OPENSSL_LIB).
for p in \
    /opt/homebrew/opt/openssl@3 \
    /usr/local/opt/openssl@3 \
    /opt/homebrew/opt/openssl \
    /usr/local/opt/openssl \
    /opt/local
do
    if [ -f "$p/include/openssl/ssl.h" ]; then
        tls_inc="-I$p/include"
        tls_lib="-L$p/lib"
        break
    fi
done
if [ -n "$openssl_include" ]; then tls_inc="-I$openssl_include"; fi
if [ -n "$openssl_lib" ];     then tls_lib="-L$openssl_lib";     fi
if [ -n "$OPENSSL_INCLUDE" ]; then tls_inc="-I$OPENSSL_INCLUDE"; fi
if [ -n "$OPENSSL_LIB" ];     then tls_lib="-L$OPENSSL_LIB";     fi

# Probe libmelon_static.a for the TLS API by inspecting its symbol
# table rather than compiling/linking against it.  The detection
# must NOT require OpenSSL headers: that's the whole point of the
# probe -- a host that built Melon-with-TLS but later removed
# libssl-dev still has the TLS code in libmelon_static.a, and we
# need to detect that so we can emit a clear OpenSSL-missing error
# instead of mis-detecting Melon as no-TLS and dying at the final
# link step.
#
# Order of preference (each tool is widely shipped in binutils):
#   1. nm           -- most precise, decodes section type (T/t/R/r).
#   2. objdump      -- same precision as nm; sometimes present when
#                      nm isn't (e.g. some embedded toolchains).
#   3. strings      -- universal fallback; matches the symbol name
#                      as a string in the archive bytes.  Slightly
#                      lossier (could match commentary in object
#                      sections) but for a unique symbol name like
#                      `mln_tcp_tls_conf_new` it is reliable in
#                      practice.
melon_archive="$libmelonPath/lib/libmelon_static.a"
if [ -f "$melon_archive" ]; then
    if command -v nm >/dev/null 2>&1; then
        if nm "$melon_archive" 2>/dev/null \
            | grep -E ' (T|t|R|r) (_)?mln_tcp_tls_conf_new$' \
            >/dev/null 2>&1
        then
            melon_has_tls=1
        fi
    fi
    if [ $melon_has_tls -eq 0 ] && command -v objdump >/dev/null 2>&1; then
        if objdump --syms "$melon_archive" 2>/dev/null \
            | grep -E '(^| )(_)?mln_tcp_tls_conf_new$' \
            >/dev/null 2>&1
        then
            melon_has_tls=1
        fi
    fi
    if [ $melon_has_tls -eq 0 ] && command -v strings >/dev/null 2>&1; then
        # Anchor to a NUL-delimited match by checking line equality
        # rather than relying on grep -E word boundaries, which are
        # locale-dependent.
        if strings "$melon_archive" 2>/dev/null \
            | grep -E '^_?mln_tcp_tls_conf_new$' \
            >/dev/null 2>&1
        then
            melon_has_tls=1
        fi
    fi
fi

if [ $melon_has_tls -eq 1 ]; then
    # Verify OpenSSL is available.  libmelon_static.a carries
    # unresolved references to libssl/libcrypto whenever Melon was
    # built with --enable-tls, so EVERY link (melang itself plus
    # every .so we ship) needs -lssl -lcrypto -- including when the
    # user passed --disable-tls, because that flag only skips
    # tls.so / the https_request branch.  It does NOT change the
    # libmelon_static.a we're linking against.  If OpenSSL is
    # missing we cannot proceed -- error out loudly with a recovery
    # hint instead of letting the final link fail with cryptic
    # "undefined reference to SSL_*" messages.
    echo -e "#include <openssl/ssl.h>\nint main(void){SSL_CTX_new(TLS_method());return 0;}" > tls_probe.c
    $cc $tls_inc -o tls_probe tls_probe.c $tls_lib -lssl -lcrypto 2>/dev/null
    openssl_ok=$?
    rm -f tls_probe tls_probe.c
    if [ "$openssl_ok" = "0" ]; then
        # The OpenSSL link flags are always needed when Melon has TLS,
        # regardless of whether we build tls.so on the Melang side.
        tls_ldflags="$tls_lib -lssl -lcrypto"
        if [ "$tls_user_choice" = "disable" ]; then
            # Opt-out: still link OpenSSL (for libmelon_static.a) but
            # don't define MLN_TLS for our .c files and don't build
            # tls.so.  http.so loses the https_request branch.
            build_tls=0
            tls_flag=""
            echo -e "TLS\t\t\t[disabled by user]"
        else
            tls_flag="-DMLN_TLS $tls_inc"
            build_tls=1
            echo -e "TLS\t\t\t[OpenSSL]"
        fi
    else
        echo -e "TLS\t\t\t[ERROR]"
        echo "  reason: libmelon_static.a was built with TLS support, but"
        echo "          OpenSSL headers/libs could not be located on this"
        echo "          host.  Every link of libmelon_static.a needs"
        echo "          -lssl -lcrypto."
        echo "  fix:    install OpenSSL development files (e.g."
        echo "          'apt install libssl-dev' / 'brew install openssl')"
        echo "          and/or pass --openssl-include=DIR --openssl-lib=DIR"
        echo "          (or set OPENSSL_INCLUDE / OPENSSL_LIB)."
        echo "          Note: --disable-tls does NOT help here -- the"
        echo "          static archive still pulls in OpenSSL symbols.  To"
        echo "          build without OpenSSL at all, rebuild Melon"
        echo "          without --enable-tls and re-run this configure."
        exit 1
    fi
else
    if [ "$tls_user_choice" = "enable" ]; then
        # User asked for --enable-tls but Melon doesn't have TLS.
        # The flag is documented as a compat no-op now; surface a
        # clear message so the user knows why tls.so is missing.
        echo -e "TLS\t\t\t[NOT supported]"
        echo "  reason: libmelon_static.a does not export the TLS API."
        echo "          Rebuild Melon with: ./configure --enable-tls"
        echo "  effect: tls.so will NOT be built or installed."
    fi
fi

# Generate Makefile
echo "#" > Makefile
echo "# Copyright (C) Niklaus F.Schen." >> Makefile
echo "#" >> Makefile
echo "CC	= $cc" >> Makefile
echo "MCC	= $mcc" >> Makefile
echo "FLAGS           = -I$libmelonPath/include -Ilib_src $tls_flag -c -Wall $debug $c99 -Werror -O3 -fPIC" >> Makefile
if [ $wasm -eq 1 ]; then
    echo "MFLAGS          = -I$libmelonPath/include -c $debug $c99 -O3 $llvm_flag -s -mmutable-globals -mnontrapping-fptoint -msign-ext -Wemcc" >> Makefile
    echo "MELANG          = melang.wasm" >> Makefile
else
    echo "MFLAGS           = -I$libmelonPath/include -c -Wall $debug $c99 -Werror -O3 -fPIC" >> Makefile
    echo "MELANG          = melang" >> Makefile
fi
if ! case $os in MINGW*) false;; esac; then
echo "LIBAES		= aes.dll" >> Makefile
echo "LIBBASE64	= base64.dll" >> Makefile
echo "LIBDES		= des.dll" >> Makefile
echo "LIBFILE		= file.dll" >> Makefile
echo "LIBJSON		= json.dll" >> Makefile
echo "LIBHTTP		= http.dll" >> Makefile
echo "LIBMATRIX	= matrix.dll" >> Makefile
echo "LIBMD5		= md5.dll" >> Makefile
echo "LIBMQ		= mq.dll" >> Makefile
echo "LIBMYSQL	= mysql.dll" >> Makefile
echo "LIBNETWORK	= net.dll" >> Makefile
echo "LIBPRIME	= prime.dll" >> Makefile
echo "LIBRC		= rc.dll" >> Makefile
echo "LIBSHA		= sha.dll" >> Makefile
echo "LIBSTR		= str.dll" >> Makefile
echo "LIBSYS		= sys.dll" >> Makefile
if [ $build_tls -eq 1 ]; then
echo "LIBTLS		= tls.dll" >> Makefile
fi
else
echo "LIBAES		= aes.so" >> Makefile
echo "LIBBASE64	= base64.so" >> Makefile
echo "LIBDES		= des.so" >> Makefile
echo "LIBFILE		= file.so" >> Makefile
echo "LIBJSON		= json.so" >> Makefile
echo "LIBHTTP		= http.so" >> Makefile
echo "LIBMATRIX	= matrix.so" >> Makefile
echo "LIBMD5		= md5.so" >> Makefile
echo "LIBMQ		= mq.so" >> Makefile
echo "LIBMYSQL	= mysql.so" >> Makefile
echo "LIBNETWORK	= net.so" >> Makefile
echo "LIBPRIME	= prime.so" >> Makefile
echo "LIBRC		= rc.so" >> Makefile
echo "LIBSHA		= sha.so" >> Makefile
echo "LIBSTR		= str.so" >> Makefile
echo "LIBSYS		= sys.so" >> Makefile
if [ $build_tls -eq 1 ]; then
echo "LIBTLS		= tls.so" >> Makefile
fi
fi
echo "" >> Makefile
echo "MELANGOBJS	= objs/melang.o" >> Makefile
echo "LIBAESOBJS	= objs/mln_lang_aes.o" >> Makefile
echo "LIBBASE64OBJS	= objs/mln_lang_base64.o" >> Makefile
echo "LIBDESOBJS	= objs/mln_lang_des.o" >> Makefile
echo "LIBFILEOBJS	= objs/mln_lang_file.o" >> Makefile
echo "LIBJSONOBJS	= objs/mln_lang_json.o" >> Makefile
echo "LIBHTTPOBJS	= objs/mln_lang_http.o" >> Makefile
echo "LIBMATRIXOBJS	= objs/mln_lang_matrix.o" >> Makefile
echo "LIBMD5OBJS	= objs/mln_lang_md5.o" >> Makefile
echo "LIBMQOBJS	        = objs/mln_lang_msgqueue.o objs/mln_lang_msgqueue_impl.o" >> Makefile
echo "LIBMYSQLOBJS	= objs/mln_lang_mysql.o" >> Makefile
echo "LIBNETWORKOBJS	= objs/mln_lang_network.o" >> Makefile
echo "LIBPRIMEOBJS	= objs/mln_lang_prime.o" >> Makefile
echo "LIBRCOBJS	        = objs/mln_lang_rc.o" >> Makefile
echo "LIBSHAOBJS	= objs/mln_lang_sha.o" >> Makefile
echo "LIBSTROBJS	= objs/mln_lang_string.o" >> Makefile
echo "LIBSYSOBJS	= objs/mln_lang_sys.o" >> Makefile
if [ $build_tls -eq 1 ]; then
echo "LIBTLSOBJS	= objs/mln_lang_tls.o" >> Makefile
fi
echo "" >> Makefile
echo ".PHONY :	compile all install clean" >> Makefile
echo "compile: PREPARE \$(MELANGOBJS) \$(MELANG) COMPILECLEAN" >> Makefile
echo "lib:     PREPARE \$(LIBAESOBJS) \$(LIBBASE64OBJS) \$(LIBDESOBJS) \$(LIBFILEOBJS) \$(LIBJSONOBJS) \\" >> Makefile
echo "         \$(LIBMATRIXOBJS) \$(LIBMD5OBJS) \$(LIBMQOBJS) \$(LIBMYSQLOBJS) \$(LIBNETWORKOBJS) \$(LIBPRIMEOBJS) \\" >> Makefile
echo "         \$(LIBRCOBJS) \$(LIBSHAOBJS) \$(LIBSTROBJS) \$(LIBSYSOBJS) \$(LIBHTTPOBJS) \$(LIBTLSOBJS) \\" >> Makefile
echo "         \$(LIBAES) \$(LIBBASE64) \$(LIBDES) \$(LIBFILE) \$(LIBJSON) \$(LIBMATRIX) \$(LIBMD5) \\" >> Makefile
echo "         \$(LIBMQ) \$(LIBMYSQL) \$(LIBNETWORK) \$(LIBPRIME) \$(LIBRC) \$(LIBSHA) \$(LIBSTR) \$(LIBSYS) \\" >> Makefile
echo "         \$(LIBHTTP) \$(LIBTLS) \\" >> Makefile
echo "         COMPILECLEAN" >> Makefile
echo "all:     PREPARE \$(MELANGOBJS) \$(LIBAESOBJS) \$(LIBBASE64OBJS) \$(LIBDESOBJS) \$(LIBFILEOBJS) \$(LIBJSONOBJS) \\" >> Makefile
echo "         \$(LIBMATRIXOBJS) \$(LIBMD5OBJS) \$(LIBMQOBJS) \$(LIBMYSQLOBJS) \$(LIBNETWORKOBJS) \$(LIBPRIMEOBJS) \\" >> Makefile
echo "         \$(LIBRCOBJS) \$(LIBSHAOBJS) \$(LIBSTROBJS) \$(LIBSYSOBJS) \$(LIBHTTPOBJS) \$(LIBTLSOBJS) \\" >> Makefile
echo "         \$(MELANG) \$(LIBAES) \$(LIBBASE64) \$(LIBDES) \$(LIBFILE) \$(LIBJSON) \$(LIBMATRIX) \$(LIBMD5) \\" >> Makefile
echo "         \$(LIBMQ) \$(LIBMYSQL) \$(LIBNETWORK) \$(LIBPRIME) \$(LIBRC) \$(LIBSHA) \$(LIBSTR) \$(LIBSYS) \\" >> Makefile
echo "         \$(LIBHTTP) \$(LIBTLS) \\" >> Makefile
echo "         COMPILECLEAN" >> Makefile
echo "clean:" >> Makefile
echo "	rm -fr objs libs bin Makefile" >> Makefile
echo "PREPARE :" >> Makefile
echo "	test -d objs || mkdir objs" >> Makefile
echo "	test -d libs || mkdir libs" >> Makefile
echo "	test -d bin || mkdir bin" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo -en " \b"
else
	echo "	cp -f $libmelonPath/lib/libmelon_static.a ." >> Makefile
fi
echo "COMPILECLEAN :" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo -en " \b"
else
	echo "	rm -f libmelon_static.a" >> Makefile
fi
echo "\$(MELANG) : \$(MELANGOBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(MCC) -o bin/\$@ \$^ -static -O3 -L$libmelonPath/lib -llibmelon -lpthread $mysql_lib -lWs2_32 $tls_ldflags" >> Makefile
else
	echo "	\$(MCC) -o bin/\$@ \$^ -O3 -L. -lmelon_static -ldl -lpthread $mysql_lib $tls_ldflags" >> Makefile
fi
echo "\$(LIBAES) : \$(LIBAESOBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(CC) -o libs/\$@ \$^ -static $debug $c99 -Wall -lpthread -shared -fPIC -L$libmelonPath/lib -llibmelon -lWs2_32" >> Makefile
else
	echo "	\$(CC) -o libs/\$@ \$^ $debug $c99 -Wall -lpthread -lc -shared -fPIC -L. -lmelon_static" >> Makefile
fi
echo "\$(LIBBASE64) : \$(LIBBASE64OBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(CC) -o libs/\$@ \$^ -static $debug $c99 -Wall -lpthread -shared -fPIC -L$libmelonPath/lib -llibmelon -lWs2_32" >> Makefile
else
	echo "	\$(CC) -o libs/\$@ \$^ $debug $c99 -Wall -lpthread -lc -shared -fPIC -L. -lmelon_static" >> Makefile
fi
echo "\$(LIBDES) : \$(LIBDESOBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(CC) -o libs/\$@ \$^ -static $debug $c99 -Wall -lpthread -shared -fPIC -L$libmelonPath/lib -llibmelon -lWs2_32" >> Makefile
else
	echo "	\$(CC) -o libs/\$@ \$^ $debug $c99 -Wall -lpthread -lc -shared -fPIC -L. -lmelon_static" >> Makefile
fi
echo "\$(LIBFILE) : \$(LIBFILEOBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(CC) -o libs/\$@ \$^ -static $debug $c99 -Wall -lpthread -shared -fPIC -L$libmelonPath/lib -llibmelon -lWs2_32" >> Makefile
else
	echo "	\$(CC) -o libs/\$@ \$^ $debug $c99 -Wall -lpthread -lc -shared -fPIC -L. -lmelon_static" >> Makefile
fi
echo "\$(LIBJSON) : \$(LIBJSONOBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(CC) -o libs/\$@ \$^ -static $debug $c99 -Wall -lpthread -shared -fPIC -L$libmelonPath/lib -llibmelon -lWs2_32" >> Makefile
else
	echo "	\$(CC) -o libs/\$@ \$^ $debug $c99 -Wall -lpthread -lc -shared -fPIC -L. -lmelon_static" >> Makefile
fi
echo "\$(LIBHTTP) : \$(LIBHTTPOBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(CC) -o libs/\$@ \$^ -static $debug $c99 -Wall -lpthread -shared -fPIC -L$libmelonPath/lib -llibmelon -lWs2_32 $tls_ldflags" >> Makefile
else
	echo "	\$(CC) -o libs/\$@ \$^ $debug $c99 -Wall -lpthread -lc -shared -fPIC -L. -lmelon_static $tls_ldflags" >> Makefile
fi
echo "\$(LIBMATRIX) : \$(LIBMATRIXOBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(CC) -o libs/\$@ \$^ -static $debug $c99 -Wall -lpthread -shared -fPIC -L$libmelonPath/lib -llibmelon -lWs2_32" >> Makefile
else
	echo "	\$(CC) -o libs/\$@ \$^ $debug $c99 -Wall -lpthread -lc -shared -fPIC -L. -lmelon_static" >> Makefile
fi
echo "\$(LIBMD5) : \$(LIBMD5OBJS)" >> Makefile
if ! case $os in MINGW*) false;; esac; then
	echo "	\$(CC) -o libs/\$@ \$^ -static $debug $c99 -Wall -lpthread -shared -fPIC -L$libmelonPath/lib -llibmelon -lWs2_32" >> Makefile
else
	echo "	\$(CC) -o libs/\$@ \$^ $debug $c99 -Wall -lpthread -lc -shared -fPIC -L. -lmelon_static" >> Makefile
fi
